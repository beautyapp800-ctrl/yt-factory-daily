# Copy to .env and fill in. .env is gitignored and must never be committed.

# Primary provider (required): https://console.groq.com/keys
GROQ_API_KEY=

# Fallback provider (optional, skipped when empty): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Image generation, primary: https://dash.cloudflare.com -> Workers AI -> "Use REST
# API" panel has the Account ID; the token is created at My Profile -> API Tokens ->
# Create Token (custom token) with permissions Account / Workers AI / Read AND
# Account / Workers AI / Edit, Account Resources scoped to this one account. No
# credit card needed for the free 10000 Neurons/day plan.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Image generation, fallback, used only once Cloudflare is unavailable or fails:
# https://enter.pollinations.ai/keys
# Optional. Anonymous pollinations.ai requests work some of the time but answer
# 402 Payment Required unpredictably, even with a valid token (a known issue on
# their side, not specific to this one); a token measurably raises the success
# rate, though not to 100%.
POLLINATIONS_TOKEN=
