# Copy to .env and fill in. .env is gitignored and must never be committed.

# Primary provider (required): https://console.groq.com/keys
GROQ_API_KEY=

# Fallback provider (optional, skipped when empty): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Image generation, primary: https://enter.pollinations.ai/keys
# Optional. Anonymous pollinations.ai requests work some of the time but have
# started answering 402 Payment Required unpredictably; a token from an account
# there is meant to make that reliable (sent as a Bearer token - unconfirmed
# against current docs, since they could not be fetched when this was written).
POLLINATIONS_TOKEN=

# Image generation, fallback (stock photos), used only after pollinations fails
# three times: https://www.pexels.com/api/ (free, 200 req/hour, 20000/month)
PEXELS_API_KEY=
